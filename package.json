{
  "name": "prompt-modifier",
  "productName": "Prompt Modifier",
  "private": true,
  "version": "0.3.0",
  "description": "Prompt Modifier",
  "author": "MeowMaster",
  "type": "module",
  "main": "electron/main.js",
  "homepage": "https://Neytrino2134.github.io/Prompt-Modifier",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "generate-icons": "node scripts/generate-icons.js",
    "prebuild": "node scripts/generate-icons.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:image-originals": "node --test tests/image-originals.test.cjs",
    "test:session": "node --test tests/session-persistence.test.cjs",
    "test:batch-cache": "node --test tests/batch-cache.test.cjs",
    "test:performance": "node --test tests/performance-memory.test.cjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "electron:dev": "node scripts/generate-icons.js && concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "node scripts/generate-icons.js && vite build && electron-builder"
  },
  "dependencies": {
    "@google/genai": "latest",
    "jszip": "^3.10.1",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "gh-pages": "^6.1.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.promptmodifier.app",
    "productName": "Prompt Modifier",
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "executableName": "Prompt Modifier"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Prompt Modifier",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    }
  }
}
